          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"p1\",\n  \"name\": \"Football Jersey Atualizada\",\n  \"price\": 5500,\n  \"category\": \"clothes\",\n  \"distributionCenter\": \"Mogi das Cruzes\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/product",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "product"
          ]
        }
      }
    },
    {
